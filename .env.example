# --- Sunucunun iç ağdaki adı (sertifikadaki ad ile aynı olmalı) ---
RC_HOST=rc.sirket.local

# --- TURN paylaşılan gizli anahtarı: uzun ve rastgele ---  (openssl rand -hex 32)
TURN_SECRET=

# --- Kimlik doğrulama: ldap | local | both ---
AUTH_MODE=ldap

# --- LDAP / Active Directory ---
LDAP_URL=ldaps://dc.sirket.local:636
LDAP_BASE_DN=dc=sirket,dc=local
# Kullanıcıyı aramak için salt-okunur servis hesabı
LDAP_BIND_DN=cn=svc-rc,ou=Service,dc=sirket,dc=local
LDAP_BIND_PASSWORD=
# Active Directory varsayılanı. OpenLDAP için örn: (uid={u})
LDAP_USER_FILTER=(|(sAMAccountName={u})(uid={u})(userPrincipalName={u}))
# Cihaz sahipliğinin bağlanacağı kalıcı kimlik alanı (AD: sAMAccountName, OpenLDAP: uid)
LDAP_ID_ATTR=sAMAccountName
# Opsiyonel: yalnızca bu gruptaki kullanıcılar kullanabilsin (grup DN'i)
LDAP_REQUIRED_GROUP=
# ldap:// kullanıyorsanız 1 yapın (StartTLS). ldaps:// için 0.
LDAP_STARTTLS=0
# Şirket kök CA'sı gerekiyorsa certs/ klasörüne koyup yolunu verin
LDAP_CA_FILE=
